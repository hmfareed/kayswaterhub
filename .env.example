# =============================================================================
# Kay's Water & Packs - Environment Template (.env.example)
# =============================================================================

# 1. Environment & Application URLs
NODE_ENV=development
NEXTAUTH_URL=Localhost:3000
NEXT_PUBLIC_APP_URL=localhost:3000

# 2. Database (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.3tmcrvd.mongodb.net/khadys_water?retryWrites=true&w=majority"

# 3. Authentication & Security (NextAuth.js v5)
AUTH_SECRET=your_super_secret_auth_key_here
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 4. Google Gemini AI (Customer Chatbot)
GEMINI_API_KEY=your_gemini_api_key_he

# 5. Payment Gateway (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=your_paystack_webhook_secret

# 6. Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. Delivery Integration (Yango Delivery)
YANGO_API_KEY=your_yango_api_key
YANGO_API_SECRET=your_yango_api_secret
